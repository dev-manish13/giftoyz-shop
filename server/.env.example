# Public address of the site. Must be https outside localhost. Used for canonical URLs, the sitemap and payment return links.
PUBLIC_BASE_URL=http://localhost:8080
# Set to true when the shop runs behind Caddy or another proxy, so rate limits see real visitor addresses.
TRUST_PROXY=false

# Admin key for /api/admin/* and the admin panel. At least 32 characters.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# NCM (Nepal Can Move)
NCM_API_TOKEN=
NCM_BASE_URL=https://demo.nepalcanmove.com
NCM_PICKUP_BRANCH=
NCM_WEBHOOK_SECRET=
NCM_TIMEOUT_SECONDS=25
NCM_MAX_RETRIES=3
NCM_POLL_MINUTES=15
NCM_RATES_HOURS=24

# Khalti ePayment v2. Off while empty. Add after business registration and Khalti KYC.
KHALTI_SECRET_KEY=
KHALTI_ENV=sandbox
KHALTI_TIMEOUT_SECONDS=20

# Shop rules
COD_ADVANCE=true
TRACK_LIMIT_PER_MINUTE=10
ORDER_LIMIT_PER_MINUTE=5
